# ==============================================================================
# Isonga Connect (Isonga C) - Environment Configuration Template
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/isonga_connect?schema=public"

# Redis & BullMQ (Background Processing)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_replace_in_production_with_at_least_32_characters
JWT_EXPIRES_IN=1d

# SMS Gateway (Abstraction placeholder for Rwanda telcos / aggregator)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=IsongaC

# Firebase Cloud Messaging (Push Notifications)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# CORS
CORS_ORIGIN=*
